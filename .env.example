# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=3000
# URL pública del sitio (en producción con https://). Se usa en los enlaces de correo y en la protección CSRF.
BASE_URL=http://localhost:3000
# 1 si el sitio corre detrás de un proxy o hosting que termina HTTPS (Render, Railway, Nginx)
TRUST_PROXY=0

# En la nube puedes usar una sola variable en lugar de las DB_*:
# DATABASE_URL=mysql://usuario:clave@host:4000/dopta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dopta
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=dopta
# true = conexión cifrada TLS (obligatoria en TiDB Cloud / Aiven; se activa sola con esos hosts)
DB_SSL=false

# Clave que Vercel Cron envía a /api/cron/mantenimiento (solo en Vercel; cadena aleatoria larga)
CRON_SECRET=

# Correo para recuperar contraseña (vacío = el enlace se imprime en la consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dopta <no-responder@dopta.mx>

# Respaldos (RNF-06)
RESPALDO_DIR=respaldos
RESPALDO_DIAS=30
MYSQLDUMP=mysqldump

# Autocompletado de direcciones (Google Places API New). Vacío = la dirección se escribe a mano.
# Crea la key en console.cloud.google.com, activa "Places API (New)" y "Geocoding API" y restríngela a ellas.
GOOGLE_MAPS_API_KEY=
