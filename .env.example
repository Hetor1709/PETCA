# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
NODE_ENV=development
PORT=3000
# URL pública del sitio (en producción con https://). En Render se toma sola de RENDER_EXTERNAL_URL.
BASE_URL=http://localhost:3000
# 1 si el sitio corre detrás de un proxy que termina HTTPS (en Render se activa solo)
TRUST_PROXY=0

# ---------- Base de datos: PostgreSQL ----------
# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# Usa el pooler: la conexión directa de Supabase es solo IPv6 y Render no la alcanza.
# DATABASE_URL=postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local (PostgreSQL instalado en tu equipo):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dopta
# TLS: se activa solo con hosts de Supabase/Render/Neon. Forzarlo: DB_SSL=true. CA opcional: DB_SSL_CA=ruta/al/ca.pem
DB_SSL=false

# Revisa con DNS que el dominio del correo pueda recibir correo (MX). 0 = solo formato y errores comunes.
VALIDAR_CORREO_DNS=1

# Clave para que un cron externo (cron-job.org, GitHub Actions) llame a GET /api/cron/mantenimiento
# con el encabezado  Authorization: Bearer <CRON_SECRET>. Cadena aleatoria larga.
CRON_SECRET=

# Correo para recuperar contraseña (PENDIENTE). Vacío = el enlace se imprime en el log del servidor.
# Ojo: Render (plan gratis) bloquea los puertos SMTP; en producción conviene una API HTTP (Resend, Brevo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dopta <no-responder@dopta.mx>

# Respaldos (npm run respaldo, requiere pg_dump)
RESPALDO_DIR=respaldos
RESPALDO_DIAS=30
PG_DUMP=pg_dump

# Google (opcional). Vacío = la dirección se escribe a mano (el C.P. y las colonias funcionan sin Google).
# GOOGLE_MAPS_API_KEY: "Places API (New)" y "Geocoding API", restringida a esas APIs. La usa solo el servidor.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_EMBED_KEY: "Maps Embed API" (sin costo), restringida por dominio. Muestra el mapa al Administrador.
GOOGLE_MAPS_EMBED_KEY=
